<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/sk_surface">

    <!-- 大标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_chevron_right"
            android:rotation="180"
            android:tint="?attr/sk_on_surface_variant"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/flash_title"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="?attr/sk_on_surface" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- ===== 分段卡 1：安装方式 ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="8dp"
                android:text="@string/flash_install_method"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="?attr/sk_primary" />

            <!-- 刷机风险警示 -->
            <TextView
                android:id="@+id/tv_flash_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card"
                android:padding="12dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/flash_warning"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="?attr/sk_error" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card">

                <!-- 选项 A：本地修补 -->
                <LinearLayout
                    android:id="@+id/opt_local"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/radio_local"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_radio_on"
                        android:tint="?attr/sk_primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/flash_mode_local"
                            android:textSize="16sp"
                            android:textColor="?attr/sk_on_surface" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/flash_mode_local_desc"
                            android:textSize="12sp"
                            android:textColor="?attr/sk_on_surface_variant" />
                    </LinearLayout>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/sk_divider" />

                <!-- 选项 B：直接安装 -->
                <LinearLayout
                    android:id="@+id/opt_direct"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/radio_direct"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_radio_off"
                        android:tint="?attr/sk_on_surface_variant" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/flash_mode_direct"
                            android:textSize="16sp"
                            android:textColor="?attr/sk_on_surface" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/flash_mode_direct_desc"
                            android:textSize="12sp"
                            android:textColor="?attr/sk_on_surface_variant" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ===== 分段卡 2：文件 ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:text="@string/flash_image"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="?attr/sk_primary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card">

                <!-- 选择文件 -->
                <LinearLayout
                    android:id="@+id/btn_pick_image"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_apps"
                        android:tint="?attr/sk_on_surface_variant" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/flash_pick_image"
                            android:textSize="16sp"
                            android:textColor="?attr/sk_on_surface" />

                        <TextView
                            android:id="@+id/tv_flash_path"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/flash_not_selected"
                            android:textSize="12sp"
                            android:textColor="?attr/sk_on_surface_variant" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right"
                        android:tint="?attr/sk_on_surface_variant" />
                </LinearLayout>



                <View android:id="@+id/div_backup" android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/sk_divider" />

                <!-- 强制备份 -->
                <LinearLayout
                    android:id="@+id/row_backup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/cb_backup"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_status_check"
                        android:tint="?attr/sk_primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/flash_backup_before"
                            android:textSize="16sp"
                            android:textColor="?attr/sk_on_surface" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/flash_backup_desc"
                            android:textSize="12sp"
                            android:textColor="?attr/sk_on_surface_variant" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ===== 分段卡 3：镜像信息 ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:text="@string/flash_image_info"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="?attr/sk_primary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_flash_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="3dp"
                    android:text="—"
                    android:textSize="12sp"
                    android:textColor="?attr/sk_on_surface_variant" />
            </LinearLayout>

            <!-- 进度 -->
            <TextView
                android:id="@+id/tv_flash_step"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:lineSpacingExtra="3dp"
                android:text=""
                android:textSize="13sp"
                android:textColor="?attr/sk_on_surface_variant" />
        </LinearLayout>
    </ScrollView>

    <!-- 底部大按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="20dp"
        android:background="?attr/sk_surface">

        <Button
            android:id="@+id/btn_patch"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_btn_primary"
            android:text="@string/flash_next"
            android:textAllCaps="false"
            android:textColor="?attr/sk_on_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_flash"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:padding="8dp"
            android:text="@string/flash_guide"
            android:textSize="13sp"
            android:textColor="?attr/sk_primary"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</LinearLayout>
