<?xml version="1.0" encoding="utf-8"?>
<!--
  启动器页 —— 纯脚本列表，不做目录浏览。

  流程：选择一个 .sh → 复制进应用数据目录 → 从那份副本执行 → 进内置终端

  为什么不做目录浏览：这是「执行器」不是文件管理器。
  用户关心的是「我加的脚本在哪、能不能跑」，不是浏览整台设备。
  想浏览文件有 MT 管理器，那是它的专业。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 存放位置说明：让用户知道文件被复制到哪了 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/launcher_store_label"
            android:textColor="?attr/sk_on_surface_variant"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_launcher_path"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:ellipsize="middle"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:text=""
            android:textColor="?attr/sk_on_surface_variant"
            android:textSize="11sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/sk_divider" />

    <!-- 脚本列表 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/lv_launcher"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="?attr/sk_divider"
            android:dividerHeight="1px"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/tv_empty_launcher"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:padding="32dp"
            android:text="@string/launcher_empty"
            android:textColor="?attr/sk_on_surface_variant"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/sk_divider" />

    <!-- 底部操作栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="4dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/btn_launcher_pick"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="false">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_add"
                android:tint="?attr/sk_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/launcher_pick"
                android:textColor="?attr/sk_primary"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_launcher_mt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:background="?android:attr/selectableItemBackground"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="false">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_apps"
                android:tint="?attr/sk_on_surface_variant" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/launcher_pick_mt"
                android:textColor="?attr/sk_on_surface_variant"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
