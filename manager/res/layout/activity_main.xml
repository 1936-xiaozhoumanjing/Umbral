<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/sk_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/tv_appbar_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tab_home"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="?attr/sk_on_surface" />

        <ImageView
            android:id="@+id/btn_power"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_power"
            android:tint="?attr/sk_on_surface_variant"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="电源" />

        <ImageView
            android:id="@+id/btn_more"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_more_vert"
            android:tint="?attr/sk_on_surface_variant"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="更多" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/sk_divider" />

    <LinearLayout
        android:id="@+id/nav_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nav_height"
        android:orientation="horizontal"
        android:background="?attr/sk_nav_bg"
        android:gravity="center">

        <LinearLayout
            android:id="@+id/tab_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">

            <FrameLayout
                android:id="@+id/ind_home"
                android:layout_width="52dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_nav_indicator"
                android:visibility="visible">

                <ImageView
                    android:id="@+id/icon_home"
                    android:layout_width="@dimen/nav_icon"
                    android:layout_height="@dimen/nav_icon"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_home"
                    android:tint="?attr/sk_on_primary_container" />
            </FrameLayout>

            <TextView
                android:id="@+id/label_home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tab_home"
                android:textSize="10sp"
                android:textColor="?attr/sk_tab_active" />
        </LinearLayout>
        <!-- 超级用户：传统 su 通道的说明与状态 -->
                <LinearLayout
            android:id="@+id/tab_superuser"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">

            <FrameLayout
                android:id="@+id/ind_superuser"
                android:layout_width="52dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_nav_indicator"
                android:visibility="invisible">

                <ImageView
                    android:id="@+id/icon_superuser"
                    android:layout_width="@dimen/nav_icon"
                    android:layout_height="@dimen/nav_icon"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_superuser"
                    android:tint="?attr/sk_tab_inactive" />
            </FrameLayout>

            <TextView
                android:id="@+id/label_superuser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tab_shadow"
                android:textSize="10sp"
                android:textColor="?attr/sk_tab_inactive" />
        </LinearLayout>

        <!--
          启动器标签：默认隐藏，只有用户在首次启动弹窗或设置里启用后才显示。
          挂 ic_terminal 是因为它干的活就是「把文件当命令跑」。
        -->
        <LinearLayout
            android:id="@+id/tab_launcher"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            android:background="?android:attr/selectableItemBackground">

            <FrameLayout
                android:id="@+id/ind_launcher"
                android:layout_width="52dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_nav_indicator"
                android:visibility="invisible">

                <ImageView
                    android:id="@+id/icon_launcher"
                    android:layout_width="@dimen/nav_icon"
                    android:layout_height="@dimen/nav_icon"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_terminal"
                    android:tint="?attr/sk_tab_inactive" />
            </FrameLayout>

            <TextView
                android:id="@+id/label_launcher"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tab_launcher"
                android:textSize="10sp"
                android:textColor="?attr/sk_tab_inactive" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/tab_modules"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">

            <FrameLayout
                android:id="@+id/ind_modules"
                android:layout_width="52dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_nav_indicator"
                android:visibility="invisible">

                <ImageView
                    android:id="@+id/icon_modules"
                    android:layout_width="@dimen/nav_icon"
                    android:layout_height="@dimen/nav_icon"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_module"
                    android:tint="?attr/sk_tab_inactive" />
            </FrameLayout>

            <TextView
                android:id="@+id/label_modules"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tab_modules"
                android:textSize="10sp"
                android:textColor="?attr/sk_tab_inactive" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/tab_kpm"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">

            <FrameLayout
                android:id="@+id/ind_kpm"
                android:layout_width="52dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_nav_indicator"
                android:visibility="invisible">

                <ImageView
                    android:id="@+id/icon_kpm"
                    android:layout_width="@dimen/nav_icon"
                    android:layout_height="@dimen/nav_icon"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_kpm"
                    android:tint="?attr/sk_tab_inactive" />
            </FrameLayout>

            <TextView
                android:id="@+id/label_kpm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tab_kpm"
                android:textSize="10sp"
                android:textColor="?attr/sk_tab_inactive" />
        </LinearLayout>

<LinearLayout
            android:id="@+id/tab_um"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">

            <FrameLayout
                android:id="@+id/ind_um"
                android:layout_width="52dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_nav_indicator"
                android:visibility="invisible">

                <ImageView
                    android:id="@+id/icon_um"
                    android:layout_width="@dimen/nav_icon"
                    android:layout_height="@dimen/nav_icon"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_status_check"
                    android:tint="?attr/sk_tab_inactive" />
            </FrameLayout>

            <TextView
                android:id="@+id/label_um"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/um_nav"
                android:textSize="10sp"
                android:textColor="?attr/sk_tab_inactive" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/tab_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">

            <FrameLayout
                android:id="@+id/ind_settings"
                android:layout_width="52dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_nav_indicator"
                android:visibility="invisible">

                <ImageView
                    android:id="@+id/icon_settings"
                    android:layout_width="@dimen/nav_icon"
                    android:layout_height="@dimen/nav_icon"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_settings"
                    android:tint="?attr/sk_tab_inactive" />
            </FrameLayout>

            <TextView
                android:id="@+id/label_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/settings"
                android:textSize="10sp"
                android:textColor="?attr/sk_tab_inactive" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>