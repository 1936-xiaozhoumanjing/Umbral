<?xml version="1.0" encoding="utf-8"?>
<!--
    UM 模块卡片 —— 结构和 item_module.xml 完全一致（用户要求：UM 页和模块页做成一样）

      第一行  名称（加粗 16sp）
      第二行  meta（版本 · 作者 · 已对 N 个应用生效）
      第三行起 说明/错误信息，最多 8 行
      底部    重新应用按钮（一眼可见，不藏在弹窗里）
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/page_padding"
    android:paddingEnd="@dimen/page_padding"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/iv_um_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_module"
                android:tint="?attr/sk_primary"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tv_um_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/sk_on_surface"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_um_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            android:textColor="?attr/sk_on_surface_variant"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_um_err"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp"
            android:textColor="?attr/sk_on_surface_variant"
            android:maxLines="8"
            android:ellipsize="end"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

        <Button
            android:id="@+id/btn_um_editapps"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="38dp"
            android:layout_marginEnd="8dp"
            android:text="@string/um_edit_apps"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:background="@drawable/bg_card"
            android:textColor="?attr/sk_primary" />

        <Button
            android:id="@+id/btn_um_reapply"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="38dp"
            android:text="@string/um_reapply"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:background="@drawable/bg_card"
            android:textColor="?attr/sk_primary" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
