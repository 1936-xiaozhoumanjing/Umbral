<?xml version="1.0" encoding="utf-8"?>
<!--
  权限对话框 —— 照 MT 管理器的样子做。

  三行（所有者 / 用户组 / 其他），每行三个勾选（读 / 写 / 执行），
  顶部实时显示八进制。比「选一个预设档位」精确，也符合用户看惯的界面。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="8dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/tv_perm_octal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="0755  rwxr-xr-x"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?attr/sk_primary"
        android:gravity="center"
        android:paddingTop="6dp"
        android:paddingBottom="14dp" />

    <!-- 表头 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/perm_who"
            android:textSize="12sp"
            android:textColor="?attr/sk_on_surface_variant" />

        <TextView
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/perm_read"
            android:textSize="12sp"
            android:textColor="?attr/sk_on_surface_variant" />

        <TextView
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/perm_write"
            android:textSize="12sp"
            android:textColor="?attr/sk_on_surface_variant" />

        <TextView
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/perm_exec"
            android:textSize="12sp"
            android:textColor="?attr/sk_on_surface_variant" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/sk_divider" />

    <!-- 所有者 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/perm_owner"
            android:textSize="14sp"
            android:textColor="?attr/sk_on_surface" />

        <CheckBox
            android:id="@+id/cb_u_r"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:gravity="center" />

        <CheckBox
            android:id="@+id/cb_u_w"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:gravity="center" />

        <CheckBox
            android:id="@+id/cb_u_x"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:gravity="center" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/sk_divider" />

    <!-- 用户组 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/perm_group"
            android:textSize="14sp"
            android:textColor="?attr/sk_on_surface" />

        <CheckBox
            android:id="@+id/cb_g_r"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:gravity="center" />

        <CheckBox
            android:id="@+id/cb_g_w"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:gravity="center" />

        <CheckBox
            android:id="@+id/cb_g_x"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:gravity="center" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/sk_divider" />

    <!-- 其他 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/perm_other"
            android:textSize="14sp"
            android:textColor="?attr/sk_on_surface" />

        <CheckBox
            android:id="@+id/cb_o_r"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:gravity="center" />

        <CheckBox
            android:id="@+id/cb_o_w"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:gravity="center" />

        <CheckBox
            android:id="@+id/cb_o_x"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:gravity="center" />
    </LinearLayout>
</LinearLayout>
