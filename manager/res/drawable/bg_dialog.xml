<?xml version="1.0" encoding="utf-8"?>
<!--
  自绘对话框背景：大圆角 + 描边

  为什么不直接用 AlertDialog 的默认外壳：
  系统那套在不同 ROM 上长相完全不一样（红魔上就是直角、发闷），
  别人一眼就看出是「拼装 App」。这里用自己的圆角和描边，
  和整个 App 的卡片风格一致。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="?attr/sk_card" />

    <corners android:radius="22dp" />

    <stroke
        android:width="1dp"
        android:color="?attr/sk_outline" />
</shape>
