<?xml version="1.0" encoding="utf-8"?>
<!--
  卡片底。
  加了 1dp 描边 —— 之前只有纯色块，深浅两色交界处卡片边界会糊在一起，
  看起来就是「一坨」，这是它显丑的主要原因。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="?attr/sk_card" />
    <corners android:radius="20dp" />
    <stroke android:width="1dp" android:color="?attr/sk_divider" />
</shape>