<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.umbral"
    android:versionCode="900"
    android:versionName="0.90">

    <uses-sdk
        android:minSdkVersion="29"
        android:targetSdkVersion="34" />

        <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:extractNativeLibs="true"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Umbral"
        android:localeConfig="@xml/locales_config">
        <!-- 最早期的崩溃探针：ContentProvider.onCreate 比任何 Activity 都早 -->
        <provider
            android:name=".BootTrace"
            android:authorities="io.umbral.boottrace"
            android:exported="false" />


        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|smallestScreenSize|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              接收外部分享进来的 .sh / .ko。
              MT 管理器没法像文件选择器那样把文件「返回」给调用方，
              它只能分享，所以这条路是「装了 MT 就默认用 MT」的落地方式。
            -->
            <intent-filter android:label="@string/launcher_title">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/x-sh" />
                <data android:mimeType="text/x-sh" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <intent-filter android:label="@string/launcher_title">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/x-sh" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AppDetailActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|smallestScreenSize|screenLayout" />
        <activity
            android:name=".UmActivity"
            android:exported="false" />

        <!-- 影子权限页：展示内核模块状态、六项统计、授权令牌 -->
        <activity
            android:name=".ShadowActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|smallestScreenSize|screenLayout" />

        <activity
            android:name=".flash.PatchProgressActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|smallestScreenSize|screenLayout" />

        <activity
            android:name=".flash.FlashActivity"
            android:exported="true"
            android:parentActivityName=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|smallestScreenSize|screenLayout" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|smallestScreenSize|screenLayout" />
        <!-- 内置终端：执行 .sh 并实时交互 -->
        <activity
            android:name=".LauncherTerminalActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|smallestScreenSize|screenLayout" />
        <!-- 脚本编辑器：独立页面 -->
        <activity
            android:name=".LauncherEditorActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|smallestScreenSize|screenLayout" />
            <activity
            android:name=".UmRepoActivity"
            android:exported="false" />
            <activity android:name=".InstallLogActivity"
            android:exported="false" />
        <activity
        android:name=".ModuleWebUiActivity"
        android:exported="false"
        android:label="模块界面" />

</application>
</manifest>
